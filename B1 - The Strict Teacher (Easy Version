#include <bits/stdc++.h>

using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        long long n;
        int m, Q;
        cin >> n >> m >> Q;

        vector < long long > v(m);
        for (int i = 0; i < m; i++) cin >> v[i];

        long long a;
        cin >> a;

        long long L = min(v[0], v[1]);
        long long R = max(v[0], v[1]);

        long long ans, mid = (L + R) / 2;
        if (a == L || a == R) ans = 0;
        else if (a < L) ans = L - 1;
        else if (a > R) ans = n - R;
        else ans = min(abs(mid - L), abs(mid - R));

        cout << ans << "\n";
    }
}
