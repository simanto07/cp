#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n);
        int cnt_neg = 0, cnt_zero = 0;

        for (int i = 0; i < n; ++i) {
            cin >> a[i];
            if (a[i] == -1) cnt_neg++;
            else if (a[i] == 0) cnt_zero++;
        }

        int ans;
        if (cnt_neg % 2 == 0) ans = cnt_zero;
        else ans = cnt_zero + 2;

        cout << ans << "\n";
    }

    return 0;
}
