#include <bits/stdc++.h>
using namespace std;

//simanto......1st

int main() {
    
    int t; cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        string s; cin >> s;

        int cnt = 0;
        int a= -1;

        for (int i = 0; i < n; ++i) {
            if (s[i] == '1') {
                a = max(a, i + k);
            }
            if (i > a) {
                cnt++;
            }
        }

        cout << cnt << '\n';
    }
    return 0;
}
