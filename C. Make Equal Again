#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t; 
    cin >> t;
    while (t--) {
        int n; 
        cin >> n;

        vector<int> v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        if (n == 1) {
            cout << 0 << "\n";
            continue;
        }

    
        int k1 = 1;
        for (int i = 1; i < n; i++) {
            if (v[i] == v[0]) k1++;
            else break;
        }

        if (k1 == n) {
            cout << 0 << "\n";
            continue;
        }

        int k2 = 1;
        for (int i = n - 2; i >= 0; i--) {
            if (v[i] == v[n - 1]) k2++;
            else break;
        }

        int k;
        if (v[0] == v[n - 1])
            k = k1 + k2;
        else
            k = max(k1, k2);

        cout << n - k << "\n";
    }
}
