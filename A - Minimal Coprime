#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        long long l, r;
        cin >> l >> r;

        if (l < r) {
            cout << (r - l) << "\n";
        } else {
            if (l == 1) cout << 1 << "\n";
            else cout << 0 << "\n";
        }
    }
    return 0;
}
