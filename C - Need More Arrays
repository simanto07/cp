#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < int > v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        if (n <= 3) {
            int i = 0;
            while (i < (int) v.size() - 1) {
                if ((v[i] + 1) >= v[i + 1])
                    v.erase(v.begin() + i + 1);
                else
                    i++;
            }
        }

        else {
            int i = 1;
            while (i < (int) v.size() - 1) {
                if ((v[i] + 1) >= v[i + 1])
                    v.erase(v.begin() + i + 1);
                else
                    i++;
            }
        }


        int c = 1;
        for (int i = 0; i < (int) v.size() - 1; i++)
            if ((v[i] + 1) < v[i + 1]) c++;

        cout << c << endl;
    }
}
