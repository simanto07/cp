#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<long long> a(n), b;
        for (auto &x : a) cin >> x;

        sort(a.begin(), a.end());

        long long x = a[0];

        bool flag = true;
        for (long long v : a) {
            if (v % x != 0) {
                b.push_back(v);
            }
        }

        if (b.empty()) {
            cout << "YES\n";
            continue;
        }

        long long y = b[0];
        for (long long v : b) {
            if (v % y != 0) {
                flag = false;
                break;
            }
        }

        cout << (flag ? "YES\n" : "NO\n");
    }
}
