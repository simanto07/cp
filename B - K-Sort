#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        long long c = 0, mdiff = 0;
        for (int i = 1; i < n; i++) {
            if (v[i] < v[i - 1]) {
                c += v[i - 1] - v[i];
                mdiff = max(mdiff, v[i - 1] - v[i]);
                v[i] = v[i - 1];
            }
        }
        c += mdiff;
        cout << c << endl;
    }

}
