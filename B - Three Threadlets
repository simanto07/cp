
#include <bits/stdc++.h>
using namespace std;

void solve(){
	int a, b, c;
	cin >> a >> b >> c;

	if(b%a==0 && c%a==0){
		if(b/a + c/a - 2 <= 3){
			cout << "YES" << endl;
		}else cout << "NO" << endl;
	}else if(a%b==0 && c%b==0){
		if(a/b + c/b - 2 <= 3){
			cout << "YES" << endl;
		}else cout << "NO" << endl;
	}else if(a%c==0 && b%c==0){
		if(a/c + b/c - 2 <= 3){
			cout << "YES" << endl;
		}else cout << "NO" << endl;
	}else cout << "NO" << endl;

}

int main(){
	int t;
	cin >> t;

	while(t--){
		solve();
	}

	return 0;
}

