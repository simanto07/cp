#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> v(n);
        vector<int> cnt(3, 0);

        for (int i = 0; i < n; i++) {
            cin >> v[i];
            cnt[v[i] % 3]++;
        }

        int target = n / 3;
        int ans = 0;

        for (int i = 0; i < 6; i++) { 
            int j = i % 3;
            if (cnt[j] > target) {
                int extra = cnt[j] - target;
                cnt[j] -= extra;
                cnt[(j + 1) % 3] += extra;
                ans += extra;
            }
        }

        cout << ans << '\n';
    }
}
