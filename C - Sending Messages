#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        long long f, a, b;
        cin >> n >> f >> a >> b;
        vector<long long> v(n + 1);
        v[0] = 0; 
        
        for (int i = 1; i <= n; i++) cin >> v[i];

        bool flag = true;
        for (int i = 1; i <= n; i++) {
            long long diff = v[i] - v[i - 1];
            f -= min(diff * a, b);
            if (f <= 0) {
                flag = false;
                break;
            }
        }

        cout << (flag ? "YES\n" : "NO\n");
    }

    return 0;
}
