#include <bits/stdc++.h>

using namespace std;

int main() {
    // your code goes here
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<long long>v(n);
        for(int i=0;i<n;i++)cin>>v[i];
        bool flag=true;
        for(int i=0;i<n-1;i++){
            if(v[i+1]%2 != v[i]%2)flag=false;
        }
        if(flag){
            for(auto val:v)cout<<val<<" ";
            cout<<endl;
        }
        else{
            sort(v.begin(),v.end());
            for(auto val:v)cout<<val<<" ";
            cout<<endl;
        }
    }
}
