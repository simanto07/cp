#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, m, k;
        cin >> n >> m >> k;
        vector < int > v(n), v2(m);
        for (int i = 0; i < n; i++) cin >> v[i];
        for (int i = 0; i < m; i++) cin >> v2[i];

        set < int > s1, s2, s3;
        for (int i = 0; i < n; i++) {
            if (v[i] <= k) s1.insert(v[i]);
        }
        for (int i = 0; i < m; i++) {
            if (v2[i] <= k) s2.insert(v2[i]);
        }

        if (s1.size() < k / 2 || s2.size() < k / 2) {
            cout << "NO\n";
            continue;
        }

        bool flag = true;
        for (int i = 1; i <= k; i++) {
            if (!s1.count(i) && !s2.count(i)) {
                flag = false;
                break;
            }
        }


        if (flag) cout << "YES\n";
        else cout << "NO\n";
    }
}
