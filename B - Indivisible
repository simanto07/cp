#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int sum = n * (n + 1) / 2;

        if ((sum % n) == 0 && n != 1) {
            cout << -1 << endl;
            continue;
        }

        if (n == 1) {
            cout << 1 << endl;
            continue;
        }
        for (int i = 2; i <= n; i += 2)
            cout << i << " " << i - 1 << " ";
        cout << endl;
    }
}
