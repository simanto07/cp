#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int c = n;
        vector < int > v(n);
        for (int i = 1; i < n; i += 2) {
            v[i]=c;
            c--;
        }
        for (int i = 0; i < n; i += 2) {
            v[i]=c;
            c--;
        }
        for (auto val: v) cout << val << " ";
        cout << endl;
    }

    return 0;
}
