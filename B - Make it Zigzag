#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > v(n + 1);
        for (int i = 1; i <= n; i++) cin >> v[i];

        long long mx = INT_MIN;
        for (int i = 1; i <= n; i++) {
            mx = max(mx, v[i]);
            if (i % 2 == 0) v[i] = mx;
        }
        long long ans = 0;
        for (int i = 1; i < n; i++) {
            if (v[1] >= v[2]) {
                ans += v[1] - v[2] + 1;
                v[1] -= v[1] - v[2] + 1;
            }
            if (i % 2 == 0 && v[i + 1] >= v[i]) {
                ans += v[i + 1] - v[i] + 1;
                v[i + 1] -= v[i + 1] - v[i] + 1;
            }

        }
        cout << ans << endl;
    }
    return 0;
}
