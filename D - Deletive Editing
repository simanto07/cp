#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        string s, t;
        cin >> s >> t;

        if (s == t) {
            cout << "YES\n";
            continue;
        }

        unordered_map<char, int> m, m2;
        for (char c : s) m[c]++;
        for (char c : t) m2[c]++;

        string ans = "";
        for (int i = s.size() - 1; i >= 0; i--) {
            char c = s[i];
            if (t.find(c) == string::npos) continue;
            if (count(ans.begin(), ans.end(), c) < m2[c])
                ans += c;
        }

        reverse(ans.begin(), ans.end());

        if (ans == t) cout << "YES\n";
        else cout << "NO\n";
    }
    return 0;
}
