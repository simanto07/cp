#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        long long mx = INT_MIN, sum = 0, cnt = 0;
        for (int i = 0; i < n; i++) {
            sum += v[i];
            mx = max(mx, v[i]);
            if (sum - mx == mx) cnt++;
        }
        cout << cnt << endl;
    }

}
