#include <bits/stdc++.h>

using namespace std;



int main() {
    int t;
    cin >> t;
    while (t--) {
        long long n, sum = 0, ans = 0;
        cin >> n;
        while (n > 0) {
            long long c = log(n) / log(3);
            if (pow(3, c + 1) == n) c += 1;
            ans += pow(3, c+1) + c * pow(3, c - 1);
            c = pow(3, c);
            n -= c;
        }
        cout << ans << endl;
    }

}
