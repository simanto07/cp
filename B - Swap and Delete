#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        string s, ans;
        cin >> s;

        int n = (int) s.size();
        int c0 = 0, c1 = 0;

        for (int i = 0; i < n; i++) {
            if (s[i] == '0') c0++;
            else c1++;
        }

        for (int i = 0; i < n; i++) {
            if (s[i] == '0' && c1 > 0) {
                ans.push_back('1');
                c1--;
            }
            else if (s[i] == '1' && c0 > 0) {
                ans.push_back('0');
                c0--;
            }
        }

        int i = 0;
        while (i < (int) ans.size()) {
            if (ans[i] == s[i])
                ans.erase(ans.begin() + i);
            else
                i++;
        }

        cout << n - ans.size() << endl;
    }
}
