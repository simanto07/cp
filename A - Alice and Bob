#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        long long a;
        cin >> n >> a;
        vector < long long > v(n);
        for (int i = 0; i < n; i++) cin >> v[i];
        int l = 0, r = 0;
        for (int i = 0; i < n; i++) {
            if (v[i] < a) l++;
            else if (v[i] > a) r++;
        }
        if (r > l) cout << a + 1 << endl;
        else cout << a - 1 << endl;
    }
}
