    int temp;
    for(int i = 0; i < n; i++){
        cin>>temp;
        rs.push_back(temp);
    }
    sort(rs.begin(),rs.end());
    int temp1 ,temp2;
    int minimumres = 0;
    for (int i = 1; i < rs.size(); i = i + 2) {
        minimumres = max(minimumres, rs[i] - rs[i-1]);
    }
    cout << minimumres << "\n";
}
int main(){
    ios::sync_with_stdio(false);
