#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<int>v(n),v2(n),v3;
	    for(int i=0;i<n;i++)cin>>v[i];
	    for(int i=0;i<n;i++)cin>>v2[i];
	    
	    v3=v2;
	    reverse(v3.begin(),v3.end());
	    if(v==v2 || v==v3)cout<<"Bob\n";
	    else cout<<"Alice\n";
	}

}
