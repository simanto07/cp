#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;cin>>t;
	while(t--){
	    int n;cin>>n;
	    vector<int>v(n),v2(n);
	    for(int i=1;i<n;i++)cin>>v[i];
	    
	    v2[n-1]=1e9;
	    for(int i=n-2;i>=0;i--)v2[i]=v2[i+1]-v[i+1];
	    for(auto val:v2)cout<<val<<" ";
	    cout<<endl;
	}

}
