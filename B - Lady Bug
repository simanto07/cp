#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        string s, s2;
        cin >> s >> s2;

        int a = 0, b = 0;
        for (int i = 0; i < n; i++) {
            if (i % 2) {
                if (s[i] == '1') b--;
                if (s2[i] == '0') a++;
            }
            else {
                if (s[i] == '1') a--;
                if (s2[i] == '0') b++;
            }
        }
        if (a >= 0 && b >= 0) cout << "YES\n";
        else cout << "NO\n";
    }
}
