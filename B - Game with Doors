#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int l, r, L, R;
        cin >> l >> r >> L >> R;
        
        if (r < L || R<l) {
            cout << 1 << endl;
            continue;

        }
        int cnt = 0;
        vector<int>v(101,0);
        for(int i=l;i<=r;i++)v[i]++;
        for(int i=L;i<=R;i++)v[i]++;
        
        for(int i=1;i<=100;i++){
          if(v[i]==2 && v[i-1]>0)cnt++;
          if(v[i]==1 && v[i-1]==2)cnt++;
        }
        cout<<cnt<<endl;
    }
    

}
