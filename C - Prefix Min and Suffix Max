#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    cout.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> v(n), v2(n), v3(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        v2[0] = v[0];
        for (int i = 1; i < n; i++) {
            v2[i] = min(v2[i - 1], v[i]);
        }

        v3[n - 1] = v[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            v3[i] = max(v3[i + 1], v[i]);
        }

        cout << 1;
        for (int i = 1; i < n - 1; i++) {
            if (v[i] == v2[i] || v[i] == v3[i]) cout << 1;
            else cout << 0;
        }
        cout << 1 << '\n';
    }
}
