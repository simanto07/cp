#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        string s;
        cin >> s;

        char t = s[n-1];
        int cnt = 0;

        for (int i = 0; i < n - 1; i++) {
            if (s[i] != t) cnt++;
        }

        cout << cnt << endl;
    }
    return 0;
}
