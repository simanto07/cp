#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        vector < int > v(n + 1);
        for (int i = 1; i <= n; i++) cin >> v[i];

        int cnt = 0;
        unordered_map < int, int > m;
        for (int i = 1; i <= n; i++) {
            m[i] = v[i];
        }
        for (auto & p: m) {
            if (abs(p.first - p.second) % k != 0) cnt++;
        }
        if (cnt == 0) cout << 0 << endl;
        else if (cnt == 2) cout << 1 << endl;
        else cout << -1 << endl;
    }
}
