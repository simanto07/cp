//Tuple ..... intro

#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string s; 
    cin >> s;
    int n = s.size();

    vector<tuple<int,int,char>> v; 
    // (prefix_balance, position, char)

    int bal = 0;
    for (int i = 0; i < n; i++) {
        v.push_back({bal, i, s[i]});
        if (s[i] == '(') bal++;
        else bal--;
    }

    // sort by: prefix_balance ASC, position DESC
    sort(v.begin(), v.end(), [&](auto &a, auto &b){
        if (get<0>(a) != get<0>(b))
            return get<0>(a) < get<0>(b);
        return get<1>(a) > get<1>(b);
    });

    // output characters in this order
    for (auto &x : v)
        cout << get<2>(x);
}
