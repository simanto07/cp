#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > v(n);
        
        for (int i = 0; i < n; i++) {
            cin >> v[i];
        
        }
        long long x;
        cin >> x;
        long long mn = * min_element(v.begin(), v.end());
        long long mx = * max_element(v.begin(), v.end());

        if (mn <= x && x <= mx)
            cout << "YES\n";
        else
            cout << "NO\n";
    }
}
