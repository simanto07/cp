#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        long long g = 0;
        for (int i = 0; i < n; i++) {
            long long a;
            cin >> a;
            g = std::gcd(g, a);
        }

        long long ans = -1;
        for (long long x = 2; x <= 100; x++) {
            if (std::gcd(g, x) == 1) {
                ans = x;
                break;
            }
        }

        cout << ans << "\n";
    }
    return 0;
}
