#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        long long sum = 4, cnt = 2;
        if(n==1){cout<<1<<endl;continue;}
        if (n >= 2 && n <= 4) {
            cout << cnt << endl;
            continue;
        }
        while (sum < n) {
            sum++;
            sum *= 2;
            cnt++;
        }
        cout << cnt << endl;
    }

}
