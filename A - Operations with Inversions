#include <bits/stdc++.h>
using namespace std;

//simanto...
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> v(n);
        for (int i = 0; i < n; i++) cin >> v[i];

        int cnt = 0;
        int i = 0;

        while (i + 1 < v.size()) {
            if (v[i] > v[i+1]) {
                v.erase(v.begin() + i + 1);
                cnt++;
            } else {
                i++; 
            }
        }

        cout << cnt << endl;
    }
}
