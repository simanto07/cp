#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        vector < long long > v(n + 1);
        vector < int > v2(k + 1);

        for (int i = 1; i <= n; i++) cin >> v[i];
        for (int i = 1; i <= k; i++) cin >> v2[i];

        sort(v.begin() + 1, v.end(), greater < long long > ());
        sort(v2.begin() + 1, v2.end());

        int idx = 1;
        long long ans = 0;

        for (int i = 1; i <= k; i++) {
            int grpsz = v2[i];
            long long sum = 0, mn = LLONG_MAX;


            if (idx + grpsz - 1 > n) {
                for (int j = idx; j <= n; j++) ans += v[j];
                break;
            }

            for (int j = 1; j <= grpsz; j++) {
                sum += v[idx];
                mn = min(mn, v[idx]);
                idx++;
            }
            ans += sum - mn;

            if (i == k && idx <= n) {
                for (int j = idx; j <= n; j++) ans += v[j];
                break;
            }
        }

        cout << ans << endl;
    }
}
