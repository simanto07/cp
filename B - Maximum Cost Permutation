#include <bits/stdc++.h>

using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < int > v(n + 1), v2, v3;
        unordered_map < int, int > m;
        for (int i = 1; i <= n; i++) {
            cin >> v[i];
            m[v[i]]++;
        }
        for (int i = 1; i <= n; i++) {
            if (m[i] == 0) v2.push_back(i);
        }
        sort(v2.begin(), v2.end());
        int j = v2.size() - 1;
        for (int i = 1; i <= n; i++) {
            if (v[i] == 0) {
                v[i] = v2[j];
                j--;
            }
        }
        for (int i = 1; i <= n; i++) {
            if (v[i] != i) v3.push_back(i);
        }
        int ans = * max_element(v3.begin(), v3.end()) - * min_element(v3.begin(), v3.end()) + 1;
        if (ans == 1) cout << 0 << endl;
        else
            cout << ans << endl;
    }
}
