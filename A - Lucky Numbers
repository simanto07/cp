#include<iostream>
using namespace std;

int T;

int lucky(int num){
	int mx=0,mn=10;
	while(num){
		mx=max(mx,num%10);
		mn=min(mn,num%10);
		num/=10;
	}
	
	return mx-mn;
}

int main(){
	ios::sync_with_stdio(false);
	cin.tie(0),cout.tie(0);
	
	cin>>T;
	while(T--){
		int l,r,ans=-1,num;
		cin>>l>>r;
		for(int i=l;i<=r;i++){
			if(lucky(i)>ans){
				ans=lucky(i);
				num=i;
			}
			if(ans==9){
				cout<<i<<'\n';
				break;
			}
		}
		if(ans!=9) cout<<num<<'\n';
	}
	
	return 0;
}
