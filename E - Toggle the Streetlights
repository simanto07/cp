#include <bits/stdc++.h>

using namespace std;

void solve() {
    int n;
    long long k;
    cin >> n >> k;
    string s, s2;
    cin >> s;
    s2 = s;
    if (k == 0) {
        cout << s << endl;
        return;
    }
    if (k == 1) {
        for (int i = 1; i < n - 1; i++) {
            if (s[i - 1] == '1' && s[i + 1] == '1') {
                if (s[i] == '1') s2[i] = '0';
                else s2[i] = '1';
            }
        }
        cout << s2 << endl;
        return;
    }

    for (int j = 1; j <= 2; j++) {
        for (int i = 1; i < n - 1; i++) {
            if (s[i - 1] == '1' && s[i + 1] == '1') {
                if (s[i] == '1') s2[i] = '0';
                else s2[i] = '1';
            }
        }
        s = s2;
    }
    if (k % 2) {
        for (int i = 1; i < n - 1; i++) {
            if (s[i - 1] == '1' && s[i + 1] == '1') {
                if (s[i] == '1') s2[i] = '0';
                else s2[i] = '1';
            }
        }
    }
    cout << s2 << endl;
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        solve();
    }

}
